# Non-secret settings. Secrets are files in secrets/ (gitignored), created by ./setup-env.sh, which also writes this
# file as .env. After changing a secret on existing volumes, run ./observability/start.sh.

# Authorization in the Source API: off, permissive (count would-be denials) or enforce
AUTH_MODE=enforce

# Label shown in Chat alerts; use a distinct value for each deployed environment.
ALERT_ENVIRONMENT=local
