# Secrets for the whole stack. Create .env (gitignored) with ./setup-env.sh, which replaces every change-me
# with a random value. Use letters and digits only.
# Fresh volumes take these on first start; after changing one on existing volumes, run ./observability/start.sh.

# PostgreSQL superuser (admin) used by the Source API, warehouse jobs, Control Center and the quality tools
POSTGRES_PASSWORD=change-me
# Source API's DML-only role (source_api) and the read-only role of warehouse-jobs and the Control Center (app_reader)
SOURCE_API_DB_PASSWORD=change-me
APP_READER_PASSWORD=change-me
# identity service's own database (identity_db)
IDENTITY_DB_PASSWORD=change-me
# Authorization in the Source API: off, permissive (count would-be denials) or enforce
AUTH_MODE=enforce
# Debezium's replication user (cdc_user)
CDC_DB_PASSWORD=change-me
# ClickHouse admin user
CLICKHOUSE_PASSWORD=change-me
# Read-only monitor_reader in PostgreSQL and ClickHouse (platform exporter)
MONITOR_PASSWORD=change-me
# Read-only grafana_reader in ClickHouse (Grafana's ClickHouse datasource)
GRAFANA_READER_PASSWORD=change-me
# Grafana admin login; applied on Grafana's first start, reset on later runs of ./observability/start.sh
GRAFANA_ADMIN_PASSWORD=change-me
# S3 credentials of the SeaweedFS bucket that holds bronze's cold volume
COLD_STORAGE_ACCESS_KEY=change-me
COLD_STORAGE_SECRET_KEY=change-me
# Salt for hashing personal data in Debezium. Changing it changes every hash: new events no longer match
# old ones, so pick it once per environment (rotating means re-snapshotting the connector)
PII_SALT=change-me
